# Copy to .env and fill in. Never commit the real .env.

# --- Database (required) ---
# Postgres connection string, e.g. from Render / Railway / Supabase / Neon.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth (required) ---
# Any long random string. Also used to derive the credential-encryption key
# when HEX_SECRET_KEY is not set.
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- LLM (required for AI features; app still runs without it) ---
GEMINI_API_KEY=
# New Google API keys only serve the 3.6 generation (2.x flash returns
# 404 "no longer available to new users"). The app falls back through
# 3.6-flash -> flash-latest -> 2.5-flash -> 2.0-flash.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=25000

# --- Credential encryption (recommended in production) ---
# A urlsafe base64 32-byte key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HEX_SECRET_KEY=

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- Background sync ---
HEX_SCHEDULER_ENABLED=true
HEX_SYNC_INTERVAL_MINUTES=30

# --- World Watch (real-time intelligence) ---
HEX_WORLD_WATCH_ENABLED=true
HEX_WORLD_WATCH_MINUTES=20
# Shared secret for the external cron that hits POST /intelligence/refresh
# (X-HEX-Cron-Token header). Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
HEX_CRON_TOKEN=
# Web search — powers both World Watch news collection AND Copilot web
# grounding (Google results + Wikipedia). Set ONE of these (auto-detected:
# keys starting with tvly- use Tavily, anything else is treated as a
# SerpApi key). Without a key, World Watch web search is skipped and the
# Copilot falls back to Wikipedia-only. Tavily: https://tavily.com
# (~1000/mo free). SerpApi: https://serpapi.com (250/mo free).
TAVILY_API_KEY=
SERPAPI_KEY=

# --- Unified accounting connector (optional) ---
MERGE_API_KEY=

# --- Uploaded-file storage ---
# Local dir works for a single instance; use object storage for production.
HEX_UPLOAD_DIR=data/uploads
